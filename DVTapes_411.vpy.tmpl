import os
import vapoursynth as vs
core = vs.core
core.num_threads = int(os.getenv("VS_THREADS", "8"))  # 0=auto, try 6–10 on M1/M2/M3

src = core.ffms2.Source("__INPUT__")

yuv = core.resize.Spline36(
    src, format=vs.YUV422P16,
    matrix_in_s="470bg", matrix_s="470bg",
    range_in_s="limited", range_s="limited",
    chromaloc_in_s="left", chromaloc_s="left",
)

class _FakeEEDI3m:
    def EEDI3(self, *args, **kwargs):
        raise RuntimeError("EEDI3m path was called unexpectedly. QTGMC is configured to use NNEDI3.")

class _CoreProxy:
    def __getattr__(self, name):
        if name == "eedi3m":
            return _FakeEEDI3m()
        return getattr(vs.core, name)

import havsfunc as haf
haf.core = _CoreProxy()
out = haf.QTGMC(
    yuv,
    Preset="__PRESET__",
    TFF=__TFF__,
    FPSDivisor=1,
    EdiMode="NNEDI3",
    ChromaEdi="NNEDI3",
)
out.set_output()

